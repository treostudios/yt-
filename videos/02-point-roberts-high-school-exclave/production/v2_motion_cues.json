  "source_caption_frames": [
    {
      "in_frame": 0,
      "out_frame": 36,
      "text": "This school bus"
    },
    {
      "in_frame": 36,
      "out_frame": 72,
      "text": "leaves the country"
    },
    {
      "in_frame": 72,
      "out_frame": 115,
      "text": "just to take kids\nto high school."
    },
    {
      "in_frame": 122,
      "out_frame": 180,
      "text": "And the school is\nin the same state."
    },
    {
      "in_frame": 181,
      "out_frame": 209,
      "text": "First stop:"
    },
    {
      "in_frame": 215,
      "out_frame": 243,
      "text": "Canada."
    },
    {
      "in_frame": 246,
      "out_frame": 295,
      "text": "That’s the only road\nout of"
    },
    {
      "in_frame": 295,
      "out_frame": 352,
      "text": "Point Roberts,\nWashington."
    },
    {
      "in_frame": 368,
      "out_frame": 437,
      "text": "That’s Blaine, right\nacross Boundary Bay."
    },
    {
      "in_frame": 457,
      "out_frame": 487,
      "text": "It’s right there."
    },
    {
      "in_frame": 495,
      "out_frame": 526,
      "text": "Unfortunately,"
    },
    {
      "in_frame": 528,
      "out_frame": 580,
      "text": "the bus is not a boat."
    },
    {
      "in_frame": 600,
      "out_frame": 664,
      "text": "Why is this tip\neven American?"
    },
    {
      "in_frame": 669,
      "out_frame": 726,
      "text": "In 1846,"
    },
    {
      "in_frame": 727,
      "out_frame": 774,
      "text": "the Oregon Treaty\nextended the border"
    },
    {
      "in_frame": 774,
      "out_frame": 843,
      "text": "along the\n49th parallel."
    },
    {
      "in_frame": 848,
      "out_frame": 926,
      "text": "That left the tip\non the U.S. side."
    },
    {
      "in_frame": 933,
      "out_frame": 989,
      "text": "So the bus goes through\nBritish Columbia,"
    },
    {
      "in_frame": 991,
      "out_frame": 1068,
      "text": "crosses back into\nthe U.S. at Blaine,"
    },
    {
      "in_frame": 1068,
      "out_frame": 1107,
      "text": "and pulls up\nto high school."
    },
    {
      "in_frame": 1110,
      "out_frame": 1169,
      "text": "That’s about forty\nminutes on the bus."
    },
    {
      "in_frame": 1181,
      "out_frame": 1204,
      "text": "One way."
    },
    {
      "in_frame": 1267,
      "out_frame": 1312,
      "text": "Then the last bell rings,"
    },
    {
      "in_frame": 1312,
      "out_frame": 1364,
      "text": "and they do it all again."
    },
    {
      "in_frame": 1390,
      "out_frame": 1422,
      "text": "Into Canada."
    },
    {
      "in_frame": 1434,
      "out_frame": 1475,
      "text": "Back into Washington."
    },
    {
      "in_frame": 1479,
      "out_frame": 1517,
      "text": "Four border crossings,"
    },
    {
      "in_frame": 1517,
      "out_frame": 1554,
      "text": "just to go to school"
    },
    {
      "in_frame": 1554,
      "out_frame": 1596,
      "text": "in their own district."
    }
  ]
