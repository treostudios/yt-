  "captions": [
    {
      "in_frame": 0,
      "out_frame_exclusive": 43,
      "text": "Every morning,"
    },
    {
      "in_frame": 51,
      "out_frame_exclusive": 123,
      "text": "this American\nschool bus"
    },
    {
      "in_frame": 123,
      "out_frame_exclusive": 206,
      "text": "has to drive\nthrough Canada…"
    },
    {
      "in_frame": 225,
      "out_frame_exclusive": 307,
      "text": "just to stay in\nthe same state."
    },
    {
      "in_frame": 312,
      "out_frame_exclusive": 385,
      "text": "Point Roberts\nis right here."
    },
    {
      "in_frame": 391,
      "out_frame_exclusive": 503,
      "text": "Blaine High is\nright over there."
    },
    {
      "in_frame": 514,
      "out_frame_exclusive": 622,
      "text": "It’s eleven miles\nacross the bay."
    },
    {
      "in_frame": 630,
      "out_frame_exclusive": 678,
      "text": "Nice shortcut."
    },
    {
      "in_frame": 686,
      "out_frame_exclusive": 757,
      "text": "Shame there’s\nno bridge."
    },
    {
      "in_frame": 762,
      "out_frame_exclusive": 834,
      "text": "So why does\nWashington"
    },
    {
      "in_frame": 834,
      "out_frame_exclusive": 915,
      "text": "have a piece\nstuck over here?"
    },
    {
      "in_frame": 922,
      "out_frame_exclusive": 1055,
      "text": "In 1846, diplomats"
    },
    {
      "in_frame": 1055,
      "out_frame_exclusive": 1142,
      "text": "drew the forty-ninth\nparallel"
    },
    {
      "in_frame": 1142,
      "out_frame_exclusive": 1223,
      "text": "straight across\nthe map,"
    },
    {
      "in_frame": 1223,
      "out_frame_exclusive": 1303,
      "text": "accidentally\nsnipping off"
    },
    {
      "in_frame": 1303,
      "out_frame_exclusive": 1392,
      "text": "this tiny\npeninsula tip."
    },
    {
      "in_frame": 1397,
      "out_frame_exclusive": 1478,
      "text": "Which means the\nonly road out…"
    },
    {
      "in_frame": 1482,
      "out_frame_exclusive": 1548,
      "text": "leads straight into"
    },
    {
      "in_frame": 1548,
      "out_frame_exclusive": 1615,
      "text": "a foreign country."
    },
    {
      "in_frame": 1618,
      "out_frame_exclusive": 1689,
      "text": "So the bus\ncrosses here,"
    },
    {
      "in_frame": 1700,
      "out_frame_exclusive": 1766,
      "text": "loops twenty-six\nmiles"
    },
    {
      "in_frame": 1766,
      "out_frame_exclusive": 1826,
      "text": "through British\nColumbia,"
    },
    {
      "in_frame": 1826,
      "out_frame_exclusive": 1901,
      "text": "and crosses\nback into"
    },
    {
      "in_frame": 1901,
      "out_frame_exclusive": 1981,
      "text": "the U.S. at Blaine."
    },
    {
      "in_frame": 1991,
      "out_frame_exclusive": 2072,
      "text": "Two international\nborders."
    },
    {
      "in_frame": 2082,
      "out_frame_exclusive": 2130,
      "text": "Forty minutes."
    },
    {
      "in_frame": 2137,
      "out_frame_exclusive": 2211,
      "text": "And the prize\nat the end?"
    },
    {
      "in_frame": 2240,
      "out_frame_exclusive": 2280,
      "text": "Algebra."
    },
    {
      "in_frame": 2327,
      "out_frame_exclusive": 2372,
      "text": "After school?"
    },
    {
      "in_frame": 2377,
      "out_frame_exclusive": 2435,
      "text": "They do the entire"
    },
    {
      "in_frame": 2435,
      "out_frame_exclusive": 2559,
      "text": "international commute\nin reverse."
    },
    {
      "in_frame": 2568,
      "out_frame_exclusive": 2672,
      "text": "Which means these\nkids clear"
    },
    {
      "in_frame": 2672,
      "out_frame_exclusive": 2737,
      "text": "armed customs"
    },
    {
      "in_frame": 2737,
      "out_frame_exclusive": 2871,
      "text": "four times every\nsingle day…"
    },
    {
      "in_frame": 2915,
      "out_frame_exclusive": 2956,
      "text": "on a standard"
    },
    {
      "in_frame": 2956,
      "out_frame_exclusive": 3017,
      "text": "yellow school bus."
    }
  ]
}
